<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Same list as backup_rules.xml, for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="vildtudbytte.json" />
        <include domain="file" path="vildtudbytte.backup.json" />
        <include domain="file" path="artsliste.json" />
        <include domain="file" path="artsliste.backup.json" />
        <include domain="sharedpref" path="jagtapp.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="vildtudbytte.json" />
        <include domain="file" path="vildtudbytte.backup.json" />
        <include domain="file" path="artsliste.json" />
        <include domain="file" path="artsliste.backup.json" />
        <include domain="sharedpref" path="jagtapp.xml" />
    </device-transfer>
</data-extraction-rules>
